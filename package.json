{
  "name": "@qntx/nostr",
  "version": "0.0.0",
  "description": "Nostr protocol implementation and SDK in TypeScript",
  "keywords": [
    "decentralized",
    "nip",
    "nostr",
    "relay",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/qntx/nostr.js#readme",
  "bugs": {
    "url": "https://github.com/qntx/nostr.js/issues"
  },
  "license": "MIT",
  "author": "QuantX <x@qntx.fun>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/nostr.js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./core": "./dist/core.mjs",
    "./gossip": "./dist/gossip.mjs",
    "./loaders": "./dist/loaders.mjs",
    "./nips/blossom": "./dist/nips/blossom.mjs",
    "./nips/nip04": "./dist/nips/nip04.mjs",
    "./nips/nip05": "./dist/nips/nip05.mjs",
    "./nips/nip10": "./dist/nips/nip10.mjs",
    "./nips/nip11": "./dist/nips/nip11.mjs",
    "./nips/nip13": "./dist/nips/nip13.mjs",
    "./nips/nip17": "./dist/nips/nip17.mjs",
    "./nips/nip19": "./dist/nips/nip19.mjs",
    "./nips/nip21": "./dist/nips/nip21.mjs",
    "./nips/nip27": "./dist/nips/nip27.mjs",
    "./nips/nip42": "./dist/nips/nip42.mjs",
    "./nips/nip44": "./dist/nips/nip44.mjs",
    "./nips/nip46": "./dist/nips/nip46.mjs",
    "./nips/nip49": "./dist/nips/nip49.mjs",
    "./nips/nip51": "./dist/nips/nip51.mjs",
    "./nips/nip57": "./dist/nips/nip57.mjs",
    "./nips/nip59": "./dist/nips/nip59.mjs",
    "./nips/nip65": "./dist/nips/nip65.mjs",
    "./nips/nip77": "./dist/nips/nip77.mjs",
    "./nips/nip96": "./dist/nips/nip96.mjs",
    "./nips/nip98": "./dist/nips/nip98.mjs",
    "./relay": "./dist/relay.mjs",
    "./signer": "./dist/signer.mjs",
    "./storage": "./dist/storage.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "bun test tests",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "test:vp": "vp test"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^12.2.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
